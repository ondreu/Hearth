# Every setting the gallery server reads, with its default.
#
# All of it is optional: the server starts with none of this set. Copy to
# `server/.env` and change what you mean to change — docker compose picks it up
# if it exists.

# ---- Identity -------------------------------------------------------------
# Shown to clients by /v1/info, so people know which gallery they are browsing.
GALLERY_NAME=A Hearth gallery
# Optional. Shown as text; a client only opens it if the reader clicks.
TERMS_URL=

# ---- Where it listens and stores ------------------------------------------
PORT=8787
HOST=0.0.0.0
DB_PATH=/data/gallery.db

# ---- What an upload may be ------------------------------------------------
# The outer bound on a package. The format's own caps (4 MiB per picture,
# 16 MiB of pictures per package) still apply inside it, and both are checked.
MAX_PACKAGE_BYTES=16777216
MAX_NAME_LENGTH=80
MAX_DESCRIPTION_LENGTH=600
MAX_TAGS=8
# How many dashboards one identity may have published at once. A gallery is not
# a backup service. 0 turns the limit off.
MAX_ENTRIES_PER_AUTHOR=50

# ---- Rate limits ----------------------------------------------------------
# These are the whole anti-abuse story, so they are worth understanding rather
# than tuning blind. Voting is open: any identity that can sign may vote, and
# identities are free to mint, so nothing here makes vote manipulation
# impossible — only tedious. Set any of them to 0 to turn that limit off.
#
# Per identity:
UPLOADS_PER_DAY=10
VOTES_PER_DAY=200
# Per address, which is the one that actually costs an attacker something:
VOTES_PER_IP_PER_DAY=400
READS_PER_MINUTE=300
WRITES_PER_MINUTE=30

# The dial to reach for if a gallery gets a vote ring: an identity's votes don't
# count until its key is this many hours old. Off by default, because a gallery
# with nobody in it should not tell its first ten users to come back tomorrow.
VOTE_MIN_KEY_AGE_HOURS=0

# ---- Sessions -------------------------------------------------------------
TOKEN_TTL_SECONDS=86400
NONCE_TTL_SECONDS=300

# ---- Behind a proxy -------------------------------------------------------
# Set to 1 ONLY when a reverse proxy you control is in front of this server.
# With it on, the client address is read from X-Forwarded-For — a header anyone
# talking to the socket can set. On a directly exposed server that turns every
# per-address limit into a per-string limit, which is no limit at all.
TRUST_PROXY=0
