{
	"name": "hearth",
	"version": "3.0.0",
	"description": "A beautiful, customizable home screen for your vault — search, dashboard, and launcher in one.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint src test",
		"lint:fix": "eslint src test --fix",
		"test": "vitest run",
		"verify:manifests": "node scripts/verify-manifests.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"dashboard",
		"home",
		"launcher"
	],
	"author": "ondreu",
	"license": "MIT",
	"devDependencies": {
		"@stratejya/operon-cli": "^1.2.0",
		"@types/node": "^24.13.3",
		"esbuild": "^0.28.2",
		"eslint": "^10.10.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"moment": "2.29.4",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.4.0",
		"typescript-eslint": "^8.63.0",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@noble/ed25519": "^3.2.0",
		"@noble/hashes": "^2.4.0"
	}
}
